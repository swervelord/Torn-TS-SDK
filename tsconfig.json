{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "types": ["bun"],
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": false,
    "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "verbatimModuleSyntax": true, "skipLibCheck": true, "noEmit": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "tools/**/*.ts", "test/**/*.ts", "examples/**/*.ts"]
}
